# ============================================
# AI 反诈系统 - Python 微服务环境变量配置
# ============================================

# DashScope API Key（阿里云百炼大模型服务）
# 从 https://bailian.console.aliyun.com/ 获取
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ---------- 模型配置 ----------
LLM_CHAT_MODEL=qwen-plus
LLM_EMBEDDING_MODEL=text-embedding-v2
LLM_VISION_MODEL=qwen-vl-max
LLM_REASONING_MODEL=qwen-plus

# 模型参数
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# ---------- 向量库（Qdrant）----------
# 本地持久化路径
QDRANT_PATH=./qdrant_db
# 集合名
QDRANT_COLLECTION=anti_fraud_kb
# 远端 Qdrant 服务地址；留空则使用本地持久化模式
QDRANT_URL=
# 兼容既有 import 的旧变量名，指向同一路径
VECTOR_STORE_PATH=./qdrant_db

# ---------- 混合检索精排（可选）----------
# CrossEncoder 精排模型；模型不可用或下载失败时自动降级为 RRF 结果
RERANK_MODEL=BAAI/bge-reranker-base
# 置为 false 可关闭精排（仅保留 BM25 + 向量 + RRF）
RERANK_ENABLED=true

# ---------- 可选 ASR（语音转写）----------
# 未配置 ASR_API_URL 时，音频通道仅返回真实频谱数值特征，不做转写
ASR_API_URL=
# ASR 服务凭证（占位符，禁止写入明文），随 multipart 请求以 Bearer 方式传递
ASR_API_KEY=your_asr_api_key_here
