# ============================================
# AI 反诈系统 - Python 微服务环境变量配置
# ============================================

# DashScope API Key（阿里云百炼大模型服务）
# 从 https://bailian.console.aliyun.com/ 获取
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 模型配置（一般无需修改）
LLM_CHAT_MODEL=qwen-plus
LLM_EMBEDDING_MODEL=text-embedding-v2
LLM_VISION_MODEL=qwen-vl-max
LLM_REASONING_MODEL=qwen-plus

# 模型参数
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# 向量存储路径（默认：./chroma_db）
# VECTOR_STORE_PATH=./chroma_db