{
  "dataset_name": "Anti-Fraud RAG Evaluation Dataset",
  "version": "1.0",
  "description": "反诈查询测试集，覆盖5类场景：口语化查询、反诈常识问答、对抗性查询、模糊/多义查询、多轮追问",
  "sample_count": 50,
  "samples": [
    {"id": 1, "query": "我收到个短信说我中奖了要不要点", "category": "口语化查询", "expected_keywords": ["中奖", "短信", "诈骗", "钓鱼链接"]},
    {"id": 2, "query": "有人让我做任务赚钱", "category": "口语化查询", "expected_keywords": ["刷单", "任务", "兼职", "诈骗"]},
    {"id": 3, "query": "有个美女加我微信说带我投资", "category": "口语化查询", "expected_keywords": ["杀猪盘", "网恋", "投资", "诈骗"]},
    {"id": 4, "query": "接到电话说我的快递丢了要赔钱", "category": "口语化查询", "expected_keywords": ["快递", "客服", "退款", "诈骗"]},
    {"id": 5, "query": "老板在微信群里让我转账，语气不太对", "category": "口语化查询", "expected_keywords": ["冒充", "领导", "转账", "诈骗", "微信"]},
    {"id": 6, "query": "有人打电话说医保卡被冻结了", "category": "口语化查询", "expected_keywords": ["冒充", "公检法", "医保", "诈骗", "电话"]},
    {"id": 7, "query": "收到短信说我的ETC过期了要重新认证", "category": "口语化查询", "expected_keywords": ["ETC", "短信", "钓鱼", "诈骗"]},
    {"id": 8, "query": "有人加我QQ说能帮我贷款，手续很简单", "category": "口语化查询", "expected_keywords": ["贷款", "诈骗", "虚假贷款", "低息"]},
    {"id": 9, "query": "朋友发了个链接让我帮忙砍价，点进去要输手机号", "category": "口语化查询", "expected_keywords": ["链接", "钓鱼", "个人信息", "诈骗"]},
    {"id": 10, "query": "有人打电话说我在外地有个案件需要配合调查", "category": "口语化查询", "expected_keywords": ["冒充", "公检法", "电话", "诈骗"]},
    {"id": 11, "query": "看到网上广告说不用上班在家就能赚钱", "category": "口语化查询", "expected_keywords": ["兼职", "刷单", "诈骗", "虚假广告"]},
    {"id": 12, "query": "有人拉我进群说跟着老师炒股稳赚不赔", "category": "口语化查询", "expected_keywords": ["投资", "炒股", "诈骗", "虚假投资"]},
    {"id": 13, "query": "收到一条短信说我在某某平台有笔借款到期了", "category": "口语化查询", "expected_keywords": ["短信", "虚假贷款", "钓鱼", "诈骗"]},
    {"id": 14, "query": "有个人说能帮我孩子上好学校需要交点好处费", "category": "口语化查询", "expected_keywords": ["冒充", "诈骗", "转账", "虚假承诺"]},
