    {"id": 24, "query": "电信网络诈骗的常见手段有哪些", "category": "常识问答", "expected_keywords": ["电信", "诈骗", "手段", "刷单", "冒充", "投资"]},
    {"id": 25, "query": "被诈骗后应该怎么办", "category": "常识问答", "expected_keywords": ["报警", "冻结", "证据", "诈骗", "96110"]},
    {"id": 26, "query": "怎么判断是不是诈骗电话", "category": "常识问答", "expected_keywords": ["诈骗", "电话", "识别", "冒充", "公检法"]},
    {"id": 27, "query": "虚假投资诈骗有哪些套路", "category": "常识问答", "expected_keywords": ["投资", "诈骗", "套路", "虚假", "高收益"]},
    {"id": 28, "query": "客服退款诈骗是怎么骗人的", "category": "常识问答", "expected_keywords": ["客服", "退款", "诈骗", "二维码", "验证码"]},
