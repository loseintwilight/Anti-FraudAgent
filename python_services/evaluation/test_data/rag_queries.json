    {"id": 17, "query": "有人打电话说我的银行卡在境外消费了", "category": "口语化查询", "expected_keywords": ["冒充", "银行", "诈骗", "电话", "转账"]},
    {"id": 18, "query": "网上认识的人说他在国外给我寄了礼物要我付运费", "category": "口语化查询", "expected_keywords": ["网恋", "杀猪盘", "诈骗", "运费"]},
    {"id": 19, "query": "看到一个APP说下载就能领红包", "category": "口语化查询", "expected_keywords": ["APP", "红包", "诈骗", "钓鱼", "个人信息"]},
