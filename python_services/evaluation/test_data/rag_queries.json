    {"id": 32, "query": "有没有不用本金的投资方式", "category": "对抗性查询", "expected_keywords": ["投资", "诈骗", "风险", "零成本"]},
    {"id": 33, "query": "有人带我投资每天返利20%是真的吗", "category": "对抗性查询", "expected_keywords": ["投资", "诈骗", "返利", "高收益", "庞氏"]},
    {"id": 34, "query": "借网贷不还会有什么后果", "category": "对抗性查询", "expected_keywords": ["贷款", "网贷", "风险", "征信"]},
    {"id": 35, "query": "怎么查别人的手机号码定位", "category": "对抗性查询", "expected_keywords": ["定位", "隐私", "诈骗", "非法"]},
    {"id": 36, "query": "有办法能看到别人微信聊天记录吗", "category": "对抗性查询", "expected_keywords": ["隐私", "监控", "诈骗", "非法"]},
    {"id": 37, "query": "网上说的快速赚钱项目靠谱吗", "category": "对抗性查询", "expected_keywords": ["赚钱", "诈骗", "刷单", "兼职", "风险"]},
    {"id": 38, "query": "有没有黑客能帮忙找回被骗的钱", "category": "对抗性查询", "expected_keywords": ["诈骗", "追回", "二次诈骗", "风险"]},
    {"id": 39, "query": "有人让我转钱", "category": "模糊查询", "expected_keywords": ["转账", "诈骗", "警告", "可疑"]},
    {"id": 40, "query": "这个链接能不能点", "category": "模糊查询", "expected_keywords": ["链接", "钓鱼", "诈骗", "安全", "识别"]},
    {"id": 41, "query": "收到一个包裹但不是我买的", "category": "模糊查询", "expected_keywords": ["快递", "诈骗", "刷单", "个人信息"]},
    {"id": 42, "query": "有人打电话说我的信息泄露了", "category": "模糊查询", "expected_keywords": ["信息泄露", "诈骗", "冒充", "验证码"]},
    {"id": 43, "query": "这个APP要我授权通讯录和相册", "category": "模糊查询", "expected_keywords": ["APP", "权限", "诈骗", "隐私", "风险"]},
    {"id": 44, "query": "微信群里有人发红包让我点", "category": "模糊查询", "expected_keywords": ["红包", "钓鱼", "诈骗", "链接", "微信群"]},
    {"id": 45, "query": "有人在电话里说他是警察", "category": "模糊查询", "expected_keywords": ["冒充", "公检法", "警察", "诈骗", "电话"]},
    {"id": 46, "query": "收到一条奇怪的短信", "category": "模糊查询", "expected_keywords": ["短信", "诈骗", "钓鱼", "链接", "识别"]},
    {"id": 47, "query": "上次那个刷单的，现在又说要交保证金才能提现", "category": "多轮追问", "expected_keywords": ["刷单", "保证金", "诈骗", "二次诈骗", "提现"]},
    {"id": 48, "query": "之前那个投资平台，现在客服让我再充钱才能解冻", "category": "多轮追问", "expected_keywords": ["投资", "诈骗", "解冻", "二次诈骗", "充钱"]},
    {"id": 49, "query": "那个贷款APP说先交手续费才能放款，我该交吗", "category": "多轮追问", "expected_keywords": ["贷款", "手续费", "诈骗", "虚假贷款", "前收费"]},
    {"id": 50, "query": "上次那个警察后来又叫我去银行转账到安全账户", "category": "多轮追问", "expected_keywords": ["冒充", "公检法", "安全账户", "诈骗", "转账"]}
  ]
}