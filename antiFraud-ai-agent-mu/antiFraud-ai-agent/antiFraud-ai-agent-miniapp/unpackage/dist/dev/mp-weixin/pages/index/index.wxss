
.page-container.data-v-1cf27b2a {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f7fa;
}
.header.data-v-1cf27b2a {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background-color: #409EFF;
  flex-shrink: 0;
}
.header-title.data-v-1cf27b2a {
  display: flex;
  align-items: center;
}
.title-icon.data-v-1cf27b2a {
  font-size: 40rpx;
  margin-right: 12rpx;
}
.title-text.data-v-1cf27b2a {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}
.message-list.data-v-1cf27b2a {
  flex: 1;
  padding: 24rpx 32rpx;
  overflow-y: auto;
}

/* 欢迎卡片 */
.welcome-card.data-v-1cf27b2a {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  margin-top: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}
.welcome-icon.data-v-1cf27b2a {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.welcome-title.data-v-1cf27b2a {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}
.welcome-desc.data-v-1cf27b2a {
  font-size: 28rpx;
  color: #909399;
  text-align: center;
  margin-bottom: 40rpx;
  line-height: 1.6;
}
.tip-list.data-v-1cf27b2a {
  width: 100%;
}
.tip-item.data-v-1cf27b2a {
  font-size: 28rpx;
  color: #606266;
  padding: 16rpx 24rpx;
  background-color: #f5f7fa;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

/* 消息列表 */
.message-item.data-v-1cf27b2a {
  margin-bottom: 24rpx;
}
.msg-row.data-v-1cf27b2a {
  display: flex;
  align-items: flex-start;
}
.msg-row-user.data-v-1cf27b2a {
  justify-content: flex-end;
}
.msg-row-ai.data-v-1cf27b2a {
  justify-content: flex-start;
}
.msg-avatar.data-v-1cf27b2a {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
  flex-shrink: 0;
}
.msg-avatar-user.data-v-1cf27b2a {
  background-color: #409EFF;
  margin-left: 16rpx;
  order: 1;
}
.msg-avatar-ai.data-v-1cf27b2a {
  background-color: #67C23A;
  margin-right: 16rpx;
}
.msg-bubble.data-v-1cf27b2a {
  max-width: 580rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}
.msg-bubble-user.data-v-1cf27b2a {
  background-color: #409EFF;
  color: #ffffff;
  border-top-right-radius: 4rpx;
}
.msg-bubble-ai.data-v-1cf27b2a {
  background-color: #ffffff;
  color: #333;
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}
.msg-text.data-v-1cf27b2a {
  font-size: 28rpx;
  line-height: 1.6;
}

/* 检测结果样式 */
.result-header.data-v-1cf27b2a {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
  gap: 12rpx;
}
.fraud-type.data-v-1cf27b2a {
  font-size: 24rpx;
  color: #909399;
}
.result-score.data-v-1cf27b2a {
  margin-bottom: 12rpx;
}
.score-label.data-v-1cf27b2a {
  font-size: 26rpx;
  color: #606266;
}
.score-value.data-v-1cf27b2a {
  font-size: 36rpx;
  font-weight: 700;
}
.score-suffix.data-v-1cf27b2a {
  font-size: 24rpx;
  color: #909399;
}
.result-confidence.data-v-1cf27b2a {
  margin-bottom: 12rpx;
}
.confidence-label.data-v-1cf27b2a {
  font-size: 26rpx;
  color: #606266;
}
.confidence-value.data-v-1cf27b2a {
  font-size: 26rpx;
  color: #409EFF;
  font-weight: 600;
}
.result-suggestion.data-v-1cf27b2a {
  margin-bottom: 12rpx;
  padding: 16rpx;
  background-color: #f0f9eb;
  border-radius: 12rpx;
}
.suggestion-label.data-v-1cf27b2a {
  font-size: 26rpx;
  color: #67C23A;
  font-weight: 600;
}
.suggestion-text.data-v-1cf27b2a {
  font-size: 26rpx;
  color: #606266;
  line-height: 1.6;
}
.result-detail.data-v-1cf27b2a {
  margin-bottom: 12rpx;
}
.detail-label.data-v-1cf27b2a {
  font-size: 26rpx;
  color: #606266;
  display: block;
  margin-bottom: 8rpx;
}
.keyword-list.data-v-1cf27b2a {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.keyword-tag.data-v-1cf27b2a {
  font-size: 22rpx;
  color: #409EFF;
  background-color: #ecf5ff;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}
.result-action.data-v-1cf27b2a {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #ebeef5;
}
.action-btn.data-v-1cf27b2a {
  font-size: 26rpx;
  color: #409EFF;
  font-weight: 500;
}

/* 加载中 */
.loading-row.data-v-1cf27b2a {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}
.loading-bubble.data-v-1cf27b2a {
  background-color: #ffffff;
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}
.loading-dot.data-v-1cf27b2a {
  font-size: 40rpx;
  color: #909399;
  animation: loading-1cf27b2a 1.4s infinite;
  margin-right: 4rpx;
}
.loading-dot.data-v-1cf27b2a:nth-child(2) {
  animation-delay: 0.2s;
}
.loading-dot.data-v-1cf27b2a:nth-child(3) {
  animation-delay: 0.4s;
}
@keyframes loading-1cf27b2a {
0%, 60%, 100% {
    opacity: 0.3;
}
30% {
    opacity: 1;
}
}
.input-area.data-v-1cf27b2a {
  flex-shrink: 0;
  padding-bottom: env(safe-area-inset-bottom);
}
