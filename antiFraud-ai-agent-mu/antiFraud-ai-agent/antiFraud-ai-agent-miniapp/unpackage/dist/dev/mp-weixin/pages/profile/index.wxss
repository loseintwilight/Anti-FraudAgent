
.page-container.data-v-201c0da5 {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: 100rpx;
}

/* 用户信息卡片 */
.user-card.data-v-201c0da5 {
  display: flex;
  align-items: center;
  padding: 48rpx 32rpx;
  background-color: #409EFF;
  margin-bottom: 24rpx;
}
.avatar.data-v-201c0da5 {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  background-color: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}
.avatar-text.data-v-201c0da5 {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}
.user-info.data-v-201c0da5 {
  flex: 1;
}
.nickname.data-v-201c0da5 {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  display: block;
  margin-bottom: 8rpx;
}
.phone.data-v-201c0da5 {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}
.edit-btn.data-v-201c0da5 {
  padding: 8rpx 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 24rpx;
}
.edit-text.data-v-201c0da5 {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 统计卡片 */
.stats-card.data-v-201c0da5 {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  background-color: #ffffff;
  margin: 0 32rpx 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}
.stat-item.data-v-201c0da5 {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-number.data-v-201c0da5 {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
}
.stat-label.data-v-201c0da5 {
  font-size: 24rpx;
  color: #909399;
}
.stat-divider.data-v-201c0da5 {
  width: 1rpx;
  height: 60rpx;
  background-color: #ebeef5;
}

/* 功能列表 */
.menu-list.data-v-201c0da5 {
  background-color: #ffffff;
  margin: 0 32rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}
.menu-item.data-v-201c0da5 {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f7fa;
}
.menu-item.data-v-201c0da5:last-child {
  border-bottom: none;
}
.menu-icon.data-v-201c0da5 {
  font-size: 32rpx;
  margin-right: 20rpx;
  width: 40rpx;
  text-align: center;
}
.menu-label.data-v-201c0da5 {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.menu-arrow.data-v-201c0da5 {
  font-size: 28rpx;
  color: #c0c4cc;
}

/* 退出登录 */
.logout-section.data-v-201c0da5 {
  margin: 60rpx 32rpx;
}
.logout-btn.data-v-201c0da5 {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background-color: #ffffff;
  color: #F56C6C;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: 2rpx solid #f0f0f0;
  padding: 0;
}
.logout-btn.data-v-201c0da5::after {
  border: none;
}
