<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.antifraud.admin.mapper.SysUserMapper">

    <!--
        注意：此 Mapper 适配 RuoYi 框架的 sys_user 表结构。
        RuoYi 的 sys_user 列名与 admin-extend.sql 不同：
        - user_id → 映射为 id
        - user_name → 映射为 username
        - phonenumber → 映射为 phone
        - role 从 sys_user_role + sys_role 关联获取
        - status char(1) ('0'=正常, '1'=停用) → 映射为 tinyint (1=启用, 0=禁用)
        - login_date → 映射为 last_login_time
        - create_time → 映射为 created_at
        - update_time → 映射为 updated_at
    -->

    <resultMap id="SysUserResult" type="com.antifraud.admin.domain.SysUser">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="phone" column="phone"/>
        <result property="role" column="role"/>
        <result property="status" column="status"/>
        <result property="avatar" column="avatar"/>
        <result property="lastLoginTime" column="last_login_time"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="selectUserVo">
        SELECT
            u.user_id AS id,
            u.user_name AS username,
            u.password,
            u.phonenumber AS phone,
            COALESCE(
                (SELECT r.role_key
                 FROM sys_user_role ur
                 JOIN sys_role r ON ur.role_id = r.role_id
                 WHERE ur.user_id = u.user_id
                 LIMIT 1),
                'user'
            ) AS role,
            CASE WHEN u.status = '0' THEN 1 ELSE 0 END AS status,
            u.avatar,
            u.login_date AS last_login_time,
            u.create_time AS created_at,
            u.update_time AS updated_at
        FROM sys_user u
    </sql>

    <select id="selectUserById" parameterType="Long" resultMap="SysUserResult">
        <include refid="selectUserVo"/>
        WHERE u.user_id = #{id}
    </select>

    <select id="selectUserByUsername" parameterType="String" resultMap="SysUserResult">
        <include refid="selectUserVo"/>
        WHERE u.user_name = #{username}
    </select>

    <select id="selectUserList" parameterType="com.antifraud.admin.domain.SysUser" resultMap="SysUserResult">
        <include refid="selectUserVo"/>
        <where>
            <if test="username != null and username != ''">
                AND u.user_name LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="phone != null and phone != ''">
                AND u.phonenumber LIKE CONCAT('%', #{phone}, '%')
            </if>
            <if test="status != null">
                AND CASE WHEN u.status = '0' THEN 1 ELSE 0 END = #{status}
            </if>
        </where>
        ORDER BY u.create_time DESC
    </select>

    <insert id="insertUser" parameterType="com.antifraud.admin.domain.SysUser" useGeneratedKeys="true" keyProperty="id" keyColumn="user_id">
        INSERT INTO sys_user
            (user_name, password, phonenumber, status, avatar, login_date, create_time, update_time)
        VALUES
            (#{username}, #{password}, #{phone},
             CASE WHEN #{status} = 1 THEN '0' ELSE '1' END,
             #{avatar}, #{lastLoginTime}, NOW(), NOW())
    </insert>

    <update id="updateUser" parameterType="com.antifraud.admin.domain.SysUser">
        UPDATE sys_user
        <set>
            <if test="username != null">user_name = #{username},</if>
            <if test="password != null">password = #{password},</if>
            <if test="phone != null">phonenumber = #{phone},</if>
            <if test="status != null">status = CASE WHEN #{status} = 1 THEN '0' ELSE '1' END,</if>
            update_time = NOW()
        </set>
        WHERE user_id = #{id}
    </update>

    <update id="updateLastLoginTime">
        UPDATE sys_user SET login_date = NOW(), update_time = NOW() WHERE user_id = #{id}
    </update>

    <delete id="deleteUserById" parameterType="Long">
        DELETE FROM sys_user WHERE user_id = #{id}
    </delete>

</mapper>