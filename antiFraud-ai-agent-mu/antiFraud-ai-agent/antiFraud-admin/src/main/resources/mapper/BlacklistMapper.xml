<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.antifraud.admin.mapper.BlacklistMapper">

    <resultMap id="BlacklistResult" type="com.antifraud.admin.domain.Blacklist">
        <id property="id" column="id"/>
        <result property="targetType" column="target_type"/>
        <result property="targetValue" column="target_value"/>
        <result property="source" column="source"/>
        <result property="reason" column="reason"/>
        <result property="status" column="status"/>
        <result property="operator" column="operator"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="selectBlacklistVo">
        SELECT id, target_type, target_value, source, reason, status, operator, created_at, updated_at
        FROM blacklist
    </sql>

    <select id="selectBlacklistList" parameterType="com.antifraud.admin.domain.Blacklist" resultMap="BlacklistResult">
        <include refid="selectBlacklistVo"/>
        <where>
            <if test="targetType != null and targetType != ''">
                AND target_type = #{targetType}
            </if>
            <if test="targetValue != null and targetValue != ''">
                AND target_value LIKE CONCAT('%', #{targetValue}, '%')
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
            <if test="source != null and source != ''">
                AND source = #{source}
            </if>
        </where>
        ORDER BY created_at DESC
    </select>

    <select id="selectBlacklistById" parameterType="Long" resultMap="BlacklistResult">
        <include refid="selectBlacklistVo"/>
        WHERE id = #{id}
    </select>

    <insert id="insertBlacklist" parameterType="com.antifraud.admin.domain.Blacklist" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO blacklist (target_type, target_value, source, reason, status, operator, created_at, updated_at)
        VALUES (#{targetType}, #{targetValue}, #{source}, #{reason}, #{status}, #{operator}, NOW(), NOW())
    </insert>

    <update id="updateBlacklist" parameterType="com.antifraud.admin.domain.Blacklist">
        UPDATE blacklist
        <set>
            <if test="targetType != null">target_type = #{targetType},</if>
            <if test="targetValue != null">target_value = #{targetValue},</if>
            <if test="source != null">source = #{source},</if>
            <if test="reason != null">reason = #{reason},</if>
            <if test="status != null">status = #{status},</if>
            <if test="operator != null">operator = #{operator},</if>
            updated_at = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteBlacklistById" parameterType="Long">
        DELETE FROM blacklist WHERE id = #{id}
    </delete>

    <delete id="deleteBlacklistByIds" parameterType="Long">
        DELETE FROM blacklist WHERE id IN
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>